<?xml version="1.0" encoding="utf-8"?>
<mdscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="X4LAN_Bubble" xsi:noNamespaceSchemaLocation="md.xsd">
    <cues>
        <cue name="Arena" namespace="this">
            <conditions>
                <event_ui_triggered screen="'X4LAN_Bubble'"/>
                <check_value value="event.param2 == 'SetupHost' or event.param2 == 'SetupGuest'"/>
            </conditions>
            <actions>
                <set_value name="$economy" exact="false"/>
                <set_value name="$coop" exact="false"/>
                <set_value name="$remoteBalance" exact="100000Cr"/>
                <set_value name="$host" exact="event.param2 == 'SetupHost'"/>
                <set_value name="$local" exact="if md.X4LAN_Bubble.PrepareShips.$own? then md.X4LAN_Bubble.PrepareShips.$own else player.ship"/>
                <set_value name="$proxy" exact="event.param3"/>
                <!-- Shared ships by wire index. Prepared ships carry the client's own index (dedicated p3
      owns ship 1, p4+ own ship 3+); legacy proxies keep the two-player order. -->
                <do_if value="md.X4LAN_Bubble.PrepareShips.$ordered? and md.X4LAN_Bubble.PrepareShips.$ordered.count ge 2">
                    <set_value name="$ships" exact="md.X4LAN_Bubble.PrepareShips.$ordered.clone"/>
                    <set_value name="$localSlot" exact="md.X4LAN_Bubble.PrepareShips.$ownIndex"/>
                </do_if>
                <do_elseif value="$host">
                    <set_value name="$ships" exact="[$local,$proxy]"/>
                    <set_value name="$localSlot" exact="1"/>
                </do_elseif>
                <do_else>
                    <set_value name="$ships" exact="[$proxy,$local]"/>
                    <set_value name="$localSlot" exact="2"/>
                </do_else>
                <set_value name="$targets" exact="[]"/>
                <set_value name="$drops" exact="[]"/>
                <set_value name="$dead" exact="[]"/>
                <set_value name="$shots" exact="[]"/>
                <set_value name="$busy" exact="false"/>
                <set_value name="$docking" exact="[]"/>
                <do_all exact="$ships.count" counter="$i">
                    <append_to_list name="$dead" exact="false"/>
                    <append_to_list name="$shots" exact="0"/>
                    <append_to_list name="$docking" exact="false"/>
                </do_all>
                <do_if value="not md.X4LAN_Bubble.PrepareShips.$own?">
                    <apply_loadout object="$proxy" loadout="$local.loadout"/>
                </do_if>
                <get_loadout loadout="'x4ep1_gamestart_trade_mercury'" macro="macro.ship_arg_m_trans_container_01_a_macro" result="$targetLoadout"/>
                <do_all exact="$ships.count" counter="$i">
                    <set_value name="$ship" exact="$ships.{$i}"/>
                    <set_object_min_hull object="$ship" exact="1"/>
                    <set_object_name object="$ship" name="'LAN Player %s'.[$i]"/>
                    <reset_weapongroups object="$ship"/>
                    <activate_weapongroup object="$ship" weapongroup="0" primary="true"/>
                    <warp object="$ship" sector="$local.sector">
                        <position x="($i * 2 - 3) * 1km" y="10km" z="0m"/>
                        <rotation yaw="0deg" pitch="0deg" roll="0deg"/>
                    </warp>
                    <set_object_velocity object="$ship">
                        <linear x="0" y="0" z="0"/>
                    </set_object_velocity>
                </do_all>
                <!-- The two LAN targets and fixture drops belong to ships 1/2 in every session size. -->
                <do_all exact="2" counter="$i">
                    <create_ship name="$target" macro="macro.ship_arg_m_trans_container_01_a_macro" sector="$local.sector">
                        <owner exact="faction.ownerless"/>
                        <loadout loadout="$targetLoadout"/>
                        <position x="($i * 2 - 3) * 1km" y="10km" z="600m"/>
                    </create_ship>
                    <set_object_name object="$target" name="'LAN Target %s'.[$i]"/>
                    <append_to_list name="$targets" exact="$target"/>
                </do_all>
                <add_to_group groupname="$weapons1" list="$ships.{1}.weapons.operational.list"/>
                <add_to_group groupname="$weapons2" list="$ships.{2}.weapons.operational.list"/>
                <do_if value="$ships.count ge 3">
                    <add_to_group groupname="$weapons3" list="$ships.{3}.weapons.operational.list"/>
                </do_if>
                <do_if value="$ships.count ge 4">
                    <add_to_group groupname="$weapons4" list="$ships.{4}.weapons.operational.list"/>
                </do_if>
                <do_if value="$ships.count ge 5">
                    <add_to_group groupname="$weapons5" list="$ships.{5}.weapons.operational.list"/>
                </do_if>
                <do_if value="$ships.count ge 6">
                    <add_to_group groupname="$weapons6" list="$ships.{6}.weapons.operational.list"/>
                </do_if>
                <do_if value="$ships.count ge 7">
                    <add_to_group groupname="$weapons7" list="$ships.{7}.weapons.operational.list"/>
                </do_if>
                <do_if value="md.X4LAN_SeedDocks.State.$testStation?">
                    <set_value name="$station" exact="md.X4LAN_SeedDocks.State.$testStation"/>
                </do_if>
                <do_else>
                    <create_station name="$station" macro="macro.station_gen_factory_base_01_macro" sector="$local.sector" owner="faction.player" state="componentstate.operational" constructionplan="'x4lan_market'" rawname="'LAN Test Station'">
                        <position x="0m" y="10km" z="5km"/>
                    </create_station>
                </do_else>
                <do_if value="$host">
                    <add_cargo object="$station" ware="ware.energycells" exact="200"/>
                </do_if>
                <create_ship name="$donor" macro="macro.ship_arg_m_trans_container_01_a_macro" sector="$local.sector">
                    <owner exact="faction.player"/>
                    <pilot>
                        <select race="race.argon"/>
                    </pilot>
                    <position x="0m" y="11km" z="0m"/>
                </create_ship>
                <add_cargo object="$donor" ware="ware.energycells" exact="40"/>
                <do_all exact="2" counter="$i">
                    <drop_cargo object="$donor" ware="ware.energycells" exact="20" groupname="$newDrops"/>
                    <append_to_list name="$drops" exact="$newDrops.{1}"/>
                    <warp object="$newDrops.{1}" sector="$local.sector">
                        <position x="($i * 2 - 3) * 1km + 150m" y="10km" z="60m"/>
                    </warp>
                    <clear_group group="$newDrops"/>
                </do_all>
                <debug_text text="'[X4LAN] BUBBLE_READY host=%s p1=%s p2=%s ships=%s local=%s station_stock=%s'.[$host,$ships.{1},$ships.{2},$ships.count,$localSlot,$station.cargo.{ware.energycells}.count]"/>
                <raise_lua_event name="'X4LAN_Bubble.Ready'"/>
            </actions>
            <cues>
                <cue name="Shots1" instantiate="true">
                    <conditions>
                        <event_weapon_fired group="$weapons1"/>
                    </conditions>
                    <actions>
                        <set_value name="$shots.{1}" operation="add" exact="1"/>
                        <do_if value="$coop and @$fireManaged.{1}">
                            <set_value name="$fireTrigger" exact="if $ships.{1}.primaryweapons.{$ships.{1}.activeweapongroup.primary}.list.indexof.{event.object} gt 0 then 1 else 2"/>
                            <set_value name="$fireRemaining.{1}.{$fireTrigger}" operation="subtract" exact="1"/>
                            <do_if value="$fireRemaining.{1}.{$fireTrigger} le 0">
                                <stop_shooting object="$ships.{1}" primary="$fireTrigger == 1" secondary="$fireTrigger == 2"/>
                            </do_if>
                        </do_if>
                        <do_if value="$coop">
                            <do_if value="player.occupiedship == $ships.{1}">
                                <raise_lua_event name="'X4LAN_Coop.Shot'" param="'1|%s'.[if $ships.{1}.primaryweapons.{$ships.{1}.activeweapongroup.primary}.list.indexof.{event.object} gt 0 then 'p' else 's']"/>
                            </do_if>
                        </do_if>
                        <do_elseif value="$localSlot == 1">
                            <raise_lua_event name="'X4LAN_Bubble.Fire'"/>
                        </do_elseif>
                    </actions>
                </cue>
                <cue name="Shots2" instantiate="true">
                    <conditions>
                        <event_weapon_fired group="$weapons2"/>
                    </conditions>
                    <actions>
                        <set_value name="$shots.{2}" operation="add" exact="1"/>
                        <do_if value="$coop and @$fireManaged.{2}">
                            <set_value name="$fireTrigger" exact="if $ships.{2}.primaryweapons.{$ships.{2}.activeweapongroup.primary}.list.indexof.{event.object} gt 0 then 1 else 2"/>
                            <set_value name="$fireRemaining.{2}.{$fireTrigger}" operation="subtract" exact="1"/>
                            <do_if value="$fireRemaining.{2}.{$fireTrigger} le 0">
                                <stop_shooting object="$ships.{2}" primary="$fireTrigger == 1" secondary="$fireTrigger == 2"/>
                            </do_if>
                        </do_if>
                        <do_if value="$coop">
                            <do_if value="player.occupiedship == $ships.{2}">
                                <raise_lua_event name="'X4LAN_Coop.Shot'" param="'2|%s'.[if $ships.{2}.primaryweapons.{$ships.{2}.activeweapongroup.primary}.list.indexof.{event.object} gt 0 then 'p' else 's']"/>
                            </do_if>
                        </do_if>
                        <do_elseif value="$localSlot == 2">
                            <raise_lua_event name="'X4LAN_Bubble.Fire'"/>
                        </do_elseif>
                    </actions>
                </cue>
                <!-- Ships 3..7 (dedicated N-player clients): the same counting as Shots1/Shots2 for FIRE2. -->
                <cue name="Shots3" instantiate="true">
                    <conditions>
                        <event_weapon_fired group="$weapons3"/>
                    </conditions>
                    <actions>
                        <set_value name="$k" exact="3"/>
                        <include_actions ref="ExtraShot"/>
                    </actions>
                </cue>
                <cue name="Shots4" instantiate="true">
                    <conditions>
                        <event_weapon_fired group="$weapons4"/>
                    </conditions>
                    <actions>
                        <set_value name="$k" exact="4"/>
                        <include_actions ref="ExtraShot"/>
                    </actions>
                </cue>
                <cue name="Shots5" instantiate="true">
                    <conditions>
                        <event_weapon_fired group="$weapons5"/>
                    </conditions>
                    <actions>
                        <set_value name="$k" exact="5"/>
                        <include_actions ref="ExtraShot"/>
                    </actions>
                </cue>
                <cue name="Shots6" instantiate="true">
                    <conditions>
                        <event_weapon_fired group="$weapons6"/>
                    </conditions>
                    <actions>
                        <set_value name="$k" exact="6"/>
                        <include_actions ref="ExtraShot"/>
                    </actions>
                </cue>
                <cue name="Shots7" instantiate="true">
                    <conditions>
                        <event_weapon_fired group="$weapons7"/>
                    </conditions>
                    <actions>
                        <set_value name="$k" exact="7"/>
                        <include_actions ref="ExtraShot"/>
                    </actions>
                </cue>
                <cue name="FireOn" instantiate="true">
                    <conditions>
                        <event_ui_triggered screen="'X4LAN_Bubble'" control="'FireOn'"/>
                    </conditions>
                    <actions>
                        <do_if value="not @$projectileVisualEnabled">
                            <shoot object="$proxy"/>
                        </do_if>
                    </actions>
                </cue>
                <cue name="FireOff" instantiate="true">
                    <conditions>
                        <event_ui_triggered screen="'X4LAN_Bubble'" control="'FireOff'"/>
                    </conditions>
                    <actions>
                        <do_if value="not @$projectileVisualEnabled or player.controlled != $proxy">
                            <stop_shooting object="$proxy"/>
                        </do_if>
                    </actions>
                </cue>
                <cue name="Publish" instantiate="true" checkinterval="0.2s">
                    <conditions>
                        <check_value value="$host"/>
                    </conditions>
                    <actions>
                        <set_value name="$t1h" exact="0"/>
                        <set_value name="$t1s" exact="0"/>
                        <set_value name="$t2h" exact="0"/>
                        <set_value name="$t2s" exact="0"/>
                        <do_if value="$targets.{1}.exists">
                            <set_value name="$t1h" exact="$targets.{1}.hullpercentage"/>
                            <set_value name="$t1s" exact="$targets.{1}.shieldpercentage"/>
                        </do_if>
                        <do_if value="$targets.{2}.exists">
                            <set_value name="$t2h" exact="$targets.{2}.hullpercentage"/>
                            <set_value name="$t2s" exact="$targets.{2}.shieldpercentage"/>
                        </do_if>
                        <set_value name="$d1" exact="if $ships.{1}.isoperational and $ships.{1}.dock or $docking.{1} then 1 else 0"/>
                        <set_value name="$d2" exact="if $ships.{2}.isoperational and $ships.{2}.dock or $docking.{2} then 1 else 0"/>
                        <raise_lua_event name="'X4LAN_Bubble.World'" param="'%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[(if $ships.{1}.isoperational and not $dead.{1} then (if @$healthLive.{1} then $healthValue.{1}.{1} else $ships.{1}.hullpercentage) else 0),(if $ships.{1}.isoperational and not $dead.{1} then (if @$healthLive.{1} then $healthValue.{1}.{2} else $ships.{1}.shieldpercentage) else 0),(if $ships.{1}.isoperational and not $dead.{1} then $ships.{1}.cargo.{ware.energycells}.count else 0),(if $ships.{2}.isoperational and not $dead.{2} then (if @$healthLive.{2} then $healthValue.{2}.{1} else $ships.{2}.hullpercentage) else 0),(if $ships.{2}.isoperational and not $dead.{2} then (if @$healthLive.{2} then $healthValue.{2}.{2} else $ships.{2}.shieldpercentage) else 0),(if $ships.{2}.isoperational and not $dead.{2} then $ships.{2}.cargo.{ware.energycells}.count else 0),$t1h,$t1s,$t2h,$t2s,$station.cargo.{ware.energycells}.count,if $drops.{1}.exists then 1 else 0,if $drops.{2}.exists then 1 else 0,$d1,$d2,$shots.{1},$shots.{2}]"/>
                        <!-- Ships 3.. are outside the 17 WORLD values: hull|shield|cargo|dock per ship. -->
                        <do_all exact="$ships.count - 2" counter="$j">
                            <set_value name="$i" exact="$j + 2"/>
                            <set_value name="$alive" exact="$ships.{$i}.isoperational and not $dead.{$i}"/>
                            <raise_lua_event name="'X4LAN_Bubble.XShip'" param="'%s|%s|%s|%s|%s'.[$i,(if $alive then $ships.{$i}.hullpercentage else 0),(if $alive then $ships.{$i}.shieldpercentage else 0),(if $alive then $ships.{$i}.cargo.{ware.energycells}.count else 0),(if $ships.{$i}.isoperational and $ships.{$i}.dock then 1 else 0)]"/>
                        </do_all>
                    </actions>
                </cue>
                <cue name="Command" instantiate="true" namespace="this">
                    <conditions>
                        <event_ui_triggered screen="'X4LAN_Bubble'" control="'Command'"/>
                        <check_value value="Arena.$host"/>
                    </conditions>
                    <actions>
                        <set_value name="$args" exact="event.param3"/>
                        <set_value name="$slot" exact="$args.$slot"/>
                        <set_value name="$ship" exact="Arena.$ships.{$slot}"/>
                        <do_if value="Arena.$busy or not $ship.isoperational or Arena.$dead.{$slot}">
                            <raise_lua_event name="'X4LAN_Bubble.Result'" param="'%s|BUSY'.[$args.$request]"/>
                        </do_if>
                        <do_elseif value="$args.$verb == 'PICKUP'">
                            <set_value name="$drop" exact="Arena.$drops.{$slot}"/>
                            <do_if value="$drop.exists and $ship.distanceto.{$drop} le 250m and ($ship.cargo.{ware.energycells}.max - $ship.cargo.{ware.energycells}.count) ge 20">
                                <set_value name="$before" exact="$ship.cargo.{ware.energycells}.count"/>
                                <collect_drop object="$ship" drop="$drop"/>
                                <do_if value="$ship.cargo.{ware.energycells}.count == $before + 20">
                                    <raise_lua_event name="'X4LAN_Bubble.Result'" param="'%s|OK'.[$args.$request]"/>
                                    <debug_text text="'[X4LAN] HOST_PICKUP slot=%s before=%s after=%s'.[$slot,$before,$ship.cargo.{ware.energycells}.count]"/>
                                </do_if>
                                <do_else>
                                    <raise_lua_event name="'X4LAN_Bubble.Result'" param="'%s|REJECTED'.[$args.$request]"/>
                                </do_else>
                            </do_if>
                            <do_else>
                                <raise_lua_event name="'X4LAN_Bubble.Result'" param="'%s|REJECTED'.[$args.$request]"/>
                            </do_else>
                        </do_elseif>
                        <do_elseif value="$args.$verb == 'TRADE' and $ship.distanceto.{Arena.$station} lt 10km and Arena.$station.cargo.{ware.energycells}.count ge 30 and ($ship.cargo.{ware.energycells}.max - $ship.cargo.{ware.energycells}.count) ge 30">
                            <set_value name="Arena.$busy" exact="true"/>
                            <set_value name="Arena.$docking.{$slot}" exact="true"/>
                            <do_if value="$ship.owner != faction.player">
                                <set_owner object="$ship" faction="faction.player"/>
                            </do_if>
                            <start_script object="Arena.$donor.pilot" name="'x4lan.bubble.trade'">
                                <param name="ship" value="$ship"/>
                                <param name="station" value="Arena.$station"/>
                                <param name="request" value="$args.$request"/>
                                <param name="slot" value="$slot"/>
                            </start_script>
                        </do_elseif>
                        <do_else>
                            <raise_lua_event name="'X4LAN_Bubble.Result'" param="'%s|REJECTED'.[$args.$request]"/>
                        </do_else>
                    </actions>
                </cue>
                <cue name="TradeFinished" instantiate="true">
                    <conditions>
                        <event_ui_triggered screen="'X4LAN_Bubble'" control="'TradeFinished'"/>
                    </conditions>
                    <actions>
                        <set_value name="$busy" exact="false"/>
                        <set_value name="$docking.{event.param3}" exact="false"/>
                    </actions>
                </cue>
                <!-- Hull/shield are written only when they differ by more than 0.5 points: every
      set_object_shield counts as a change and re-shows the HUD shield bar, so writing the
      unchanged value on each world packet made the bar flash. -->
                <cue name="Apply" instantiate="true" namespace="this">
                    <conditions>
                        <event_ui_triggered screen="'X4LAN_Bubble'" control="'Apply'"/>
                        <check_value value="not Arena.$host"/>
                    </conditions>
                    <actions>
                        <set_value name="$v" exact="event.param3.$values"/>
                        <do_all exact="2" counter="$i">
                            <set_value name="$ship" exact="Arena.$ships.{$i}"/>
                            <do_if value="$v.{($i - 1) * 3 + 1} le (if @Arena.$healthOwn.{$i} then 0 else 1.01)">
                                <set_value name="Arena.$dead.{$i}" exact="true"/>
                            </do_if>
                            <do_if value="$ship.isoperational and not Arena.$dead.{$i}">
                                <do_if value="not @Arena.$healthOwn.{$i}">
                                    <do_if value="($ship.hullpercentage - $v.{($i - 1) * 3 + 1}) * ($ship.hullpercentage - $v.{($i - 1) * 3 + 1}) gt 0.25">
                                        <set_object_hull object="$ship" exact="$v.{($i - 1) * 3 + 1}"/>
                                    </do_if>
                                    <do_if value="($ship.shieldpercentage - $v.{($i - 1) * 3 + 2}) * ($ship.shieldpercentage - $v.{($i - 1) * 3 + 2}) gt 0.25">
                                        <set_object_shield object="$ship" exact="$v.{($i - 1) * 3 + 2}"/>
                                    </do_if>
                                </do_if>
                                <do_if value="not Arena.$economy">
                                    <set_value name="$delta" exact="$v.{$i * 3} - $ship.cargo.{ware.energycells}.count"/>
                                    <do_if value="$delta gt 0">
                                        <add_cargo object="$ship" ware="ware.energycells" exact="$delta"/>
                                    </do_if>
                                    <do_elseif value="$delta lt 0">
                                        <remove_cargo object="$ship" ware="ware.energycells" exact="-$delta"/>
                                    </do_elseif>
                                </do_if>
                            </do_if>
                            <do_if value="Arena.$targets.{$i}.exists">
                                <do_if value="Arena.$coop and $v.{5 + $i * 2} le 0">
                                    <set_object_min_hull object="Arena.$targets.{$i}" exact="0"/>
                                    <destroy_object object="Arena.$targets.{$i}" explosion="true"/>
                                </do_if>
                                <do_else>
                                    <do_if value="(Arena.$targets.{$i}.hullpercentage - $v.{5 + $i * 2}) * (Arena.$targets.{$i}.hullpercentage - $v.{5 + $i * 2}) gt 0.25">
                                        <set_object_hull object="Arena.$targets.{$i}" exact="$v.{5 + $i * 2}"/>
                                    </do_if>
                                    <do_if value="(Arena.$targets.{$i}.shieldpercentage - $v.{6 + $i * 2}) * (Arena.$targets.{$i}.shieldpercentage - $v.{6 + $i * 2}) gt 0.25">
                                        <set_object_shield object="Arena.$targets.{$i}" exact="$v.{6 + $i * 2}"/>
                                    </do_if>
                                </do_else>
                            </do_if>
                            <do_if value="$v.{11 + $i} == 0 and Arena.$drops.{$i}.exists">
                                <destroy_object object="Arena.$drops.{$i}" explosion="false"/>
                            </do_if>
                            <do_if value="not Arena.$economy">
                                <do_if value="$ship.isoperational and not Arena.$dead.{$i} and $v.{13 + $i} == 1 and not $ship.dock">
                                    <do_if value="$ship.owner != faction.player">
                                        <set_owner object="$ship" faction="faction.player"/>
                                    </do_if>
                                    <do_if value="not $ship.assigneddock">
                                        <request_docking ship="$ship" container="Arena.$station" requiretrading="true" queuedresult="$queued" grantedresult="$granted"/>
                                    </do_if>
                                    <do_if value="$ship.assigneddock">
                                        <dock ship="$ship"/>
                                    </do_if>
                                </do_if>
                            </do_if>
                        </do_all>
                        <do_if value="not Arena.$economy">
                            <set_value name="$delta" exact="$v.{11} - Arena.$station.cargo.{ware.energycells}.count"/>
                            <do_if value="$delta gt 0">
                                <add_cargo object="Arena.$station" ware="ware.energycells" exact="$delta"/>
                            </do_if>
                            <do_elseif value="$delta lt 0">
                                <remove_cargo object="Arena.$station" ware="ware.energycells" exact="-$delta"/>
                            </do_elseif>
                        </do_if>
                    </actions>
                </cue>
                <!-- Client side of XSHIP: the server's hull/shield for ships 3.. (no pilot health there). -->
                <cue name="ApplyExtra" instantiate="true" namespace="this">
                    <conditions>
                        <event_ui_triggered screen="'X4LAN_Bubble'" control="'ApplyExtra'"/>
                        <check_value value="not Arena.$host"/>
                    </conditions>
                    <actions>
                        <set_value name="$v" exact="event.param3"/>
                        <set_value name="$i" exact="$v.$ship"/>
                        <do_if value="$i ge 3 and $i le Arena.$ships.count">
                            <set_value name="$ship" exact="Arena.$ships.{$i}"/>
                            <do_if value="$v.$hull le 1.01">
                                <set_value name="Arena.$dead.{$i}" exact="true"/>
                            </do_if>
                            <do_if value="$ship.isoperational and not Arena.$dead.{$i}">
                                <do_if value="($ship.hullpercentage - $v.$hull) * ($ship.hullpercentage - $v.$hull) gt 0.25">
                                    <set_object_hull object="$ship" exact="$v.$hull"/>
                                </do_if>
                                <do_if value="($ship.shieldpercentage - $v.$shield) * ($ship.shieldpercentage - $v.$shield) gt 0.25">
                                    <set_object_shield object="$ship" exact="$v.$shield"/>
                                </do_if>
                            </do_if>
                        </do_if>
                    </actions>
                </cue>
                <cue name="Readback" instantiate="true" checkinterval="5s">
                    <conditions>
                        <check_value value="true"/>
                    </conditions>
                    <actions>
                        <debug_text text="'[X4LAN] WORLD_READBACK host=%s cargo1=%s cargo2=%s stock=%s target1_shield=%s target2_shield=%s shots1=%s shots2=%s drops1=%s drops2=%s dock1=%s dock2=%s'.[$host,(if $ships.{1}.isoperational and not $dead.{1} then $ships.{1}.cargo.{ware.energycells}.count else 0),(if $ships.{2}.isoperational and not $dead.{2} then $ships.{2}.cargo.{ware.energycells}.count else 0),$station.cargo.{ware.energycells}.count,@$targets.{1}.shieldpercentage,@$targets.{2}.shieldpercentage,$shots.{1},$shots.{2},if $drops.{1}.exists then 1 else 0,if $drops.{2}.exists then 1 else 0,if $ships.{1}.isoperational and $ships.{1}.dock then 1 else 0,if $ships.{2}.isoperational and $ships.{2}.dock then 1 else 0]"/>
                    </actions>
                </cue>
                <library name="ExtraShot" purpose="include_actions">
                    <actions>
                        <set_value name="$shots.{$k}" operation="add" exact="1"/>
                        <do_if value="$coop and @$fireManaged.{$k}">
                            <set_value name="$fireTrigger" exact="if $ships.{$k}.primaryweapons.{$ships.{$k}.activeweapongroup.primary}.list.indexof.{event.object} gt 0 then 1 else 2"/>
                            <set_value name="$fireRemaining.{$k}.{$fireTrigger}" operation="subtract" exact="1"/>
                            <do_if value="$fireRemaining.{$k}.{$fireTrigger} le 0">
                                <stop_shooting object="$ships.{$k}" primary="$fireTrigger == 1" secondary="$fireTrigger == 2"/>
                            </do_if>
                        </do_if>
                        <do_if value="$coop and player.occupiedship == $ships.{$k}">
                            <raise_lua_event name="'X4LAN_Coop.Shot'" param="'%s|%s'.[$k,if $ships.{$k}.primaryweapons.{$ships.{$k}.activeweapongroup.primary}.list.indexof.{event.object} gt 0 then 'p' else 's']"/>
                        </do_if>
                    </actions>
                </library>
            </cues>
        </cue>
        <cue name="PrepareShips" namespace="this">
            <conditions>
                <event_ui_triggered screen="'X4LAN_Bubble'" control="'PrepareShips'"/>
            </conditions>
            <actions>
                <set_value name="$args" exact="event.param3"/>
                <set_value name="$candidate" exact="null"/>
                <set_value name="$peer" exact="null"/>
                <!-- count/ownIndex: dedicated N-player sessions (one ship per client); absent = two ships. -->
                <set_value name="$count" exact="if $args.$count? then $args.$count else 2"/>
                <set_value name="$ownIndex" exact="if $args.$ownIndex? then $args.$ownIndex else 0"/>
                <set_value name="$extras" exact="[]"/>
                <set_value name="$macro" exact="macro.{$args.$macro}"/>
                <set_value name="$refusal" exact="''"/>
                <do_if value="not $macro or not $args.$sector.exists">
                    <set_value name="$refusal" exact="'macro/sector (X4: Timelines required)'"/>
                </do_if>
                <do_else>
                    <get_loadout loadout="$args.$loadout" macro="$macro" result="$loadout"/>
                    <do_if value="not $loadout">
                        <set_value name="$refusal" exact="'loadout'"/>
                    </do_if>
                    <do_else>
                        <!-- Full native creation is needed for sensor discovery. -->
                        <create_ship name="$candidate" macro="$macro" sector="$args.$sector">
                            <owner exact="faction.player"/>
                            <loadout loadout="$loadout"/>
                            <position x="$args.$localX" y="10km" z="0m"/>
                        </create_ship>
                        <create_ship name="$peer" macro="$macro" sector="$args.$sector">
                            <owner exact="faction.player"/>
                            <loadout loadout="$loadout"/>
                            <position x="-$args.$localX" y="10km" z="0m"/>
                        </create_ship>
                        <do_all exact="$count - 2" counter="$k">
                            <create_ship name="$extra" macro="$macro" sector="$args.$sector">
                                <owner exact="faction.player"/>
                                <loadout loadout="$loadout"/>
                                <position x="($k + 1) * 2km" y="10km" z="2km"/>
                            </create_ship>
                            <append_to_list name="$extras" exact="$extra"/>
                            <do_if value="not $extra.isoperational or $extra.weapons.operational.count != $candidate.weapons.operational.count or $extra.shields.operational.count != $candidate.shields.operational.count or $extra.engines.operational.count != $candidate.engines.operational.count or $extra.maxhull != $candidate.maxhull or $extra.maxshield != $candidate.maxshield">
                                <set_value name="$refusal" exact="'equipment'"/>
                            </do_if>
                        </do_all>
                        <do_if value="$count lt 2 or $count gt 7 or $ownIndex lt 0 or $ownIndex gt $count">
                            <set_value name="$refusal" exact="'ship count'"/>
                        </do_if>
                        <do_if value="$candidate.software.dock != ware.software_dockmk2 or $peer.software.dock != ware.software_dockmk2 or $candidate.weapons.operational.count != $args.$weapons or ($candidate.weapons.operational.count lt $candidate.weapons.numslots and $candidate.ammostorage.missile.capacity != 0) or $candidate.weapons.operational.count != $peer.weapons.operational.count or $candidate.shields.operational.count == 0 or $candidate.shields.operational.count != $peer.shields.operational.count or $candidate.engines.operational.count == 0 or $candidate.engines.operational.count != $peer.engines.operational.count or $candidate.maxhull != $peer.maxhull or $candidate.maxshield != $peer.maxshield">
                            <set_value name="$refusal" exact="'equipment'"/>
                        </do_if>
                    </do_else>
                </do_else>
                <do_all exact="2" counter="$i">
                    <set_value name="$ship" exact="if $i == 1 then $candidate else $peer"/>
                    <debug_text text="'[X4LAN] SHIP_SPEC role=%s macro=%s idcode=%s maxhull=%s maxshield=%s weapons=%s/%s expected=%s missilecapacity=%s weapon=%s shields=%s shield=%s engines=%s engine=%s dock=%s software=%s cargo=%s maxspeed=%s'.[if $i == 1 then 'local' else 'proxy',@$ship.macro.id,@$ship.idcode,@$ship.maxhull,@$ship.maxshield,@$ship.weapons.operational.count,@$ship.weapons.numslots,$args.$weapons,@$ship.ammostorage.missile.capacity,@$ship.weapons.operational.list.{1}.macro.id,@$ship.shields.operational.count,@$ship.shields.operational.list.{1}.macro.id,@$ship.engines.operational.count,@$ship.engines.operational.list.{1}.macro.id,@$ship.software.dock,@$ship.software.installed,@$ship.cargo.capacity.all,@$ship.maxspeed]"/>
                </do_all>
                <do_if value="$refusal != ''">
                    <debug_text text="'[X4LAN] SHIP_SPEC_REFUSED reason=%s macro=%s loadout=%s'.[$refusal,$args.$macro,$args.$loadout]"/>
                    <do_if value="$candidate.exists">
                        <destroy_object object="$candidate" explosion="false"/>
                    </do_if>
                    <do_if value="$peer.exists">
                        <destroy_object object="$peer" explosion="false"/>
                    </do_if>
                    <do_for_each name="$extra" in="$extras">
                        <do_if value="$extra.exists">
                            <destroy_object object="$extra" explosion="false"/>
                        </do_if>
                    </do_for_each>
                    <remove_value name="$candidate"/>
                    <raise_lua_event name="'X4LAN_Bubble.ShipsRefused'" param="$refusal"/>
                </do_if>
                <do_else>
                    <!-- Full personal teleportation research for internal exploration. Only after admitted ship setup. -->
                    <do_if value="not ware.research_teleportation.research.unlocked">
                        <add_research ware="ware.research_teleportation"/>
                    </do_if>
                    <do_if value="not ware.research_teleportation_range_01.research.unlocked">
                        <add_research ware="ware.research_teleportation_range_01"/>
                    </do_if>
                    <do_if value="not ware.research_teleportation_range_02.research.unlocked">
                        <add_research ware="ware.research_teleportation_range_02"/>
                    </do_if>
                    <do_if value="not ware.research_teleportation_range_03.research.unlocked">
                        <add_research ware="ware.research_teleportation_range_03"/>
                    </do_if>
                    <debug_text text="'[X4LAN] TELEPORT_RESEARCH base=%s range1=%s range2=%s range3=%s'.[ware.research_teleportation.research.unlocked,ware.research_teleportation_range_01.research.unlocked,ware.research_teleportation_range_02.research.unlocked,ware.research_teleportation_range_03.research.unlocked]"/>
                    <set_value name="$own" exact="$candidate"/>
                    <!-- Ships by wire index: own at ownIndex, then the peer and extras in ascending order
       (the same rule as bubble_game.lua). ownIndex 0 keeps the legacy two-ship order. -->
                    <do_if value="$ownIndex ge 1">
                        <set_value name="$pool" exact="[$peer]"/>
                        <do_for_each name="$extra" in="$extras">
                            <append_to_list name="$pool" exact="$extra"/>
                        </do_for_each>
                        <set_value name="$ordered" exact="[]"/>
                        <set_value name="$n" exact="0"/>
                        <do_all exact="$count" counter="$i">
                            <do_if value="$i == $ownIndex">
                                <append_to_list name="$ordered" exact="$candidate"/>
                            </do_if>
                            <do_else>
                                <set_value name="$n" operation="add" exact="1"/>
                                <append_to_list name="$ordered" exact="$pool.{$n}"/>
                            </do_else>
                        </do_all>
                    </do_if>
                    <raise_lua_event name="'X4LAN_Bubble.PreparedOwn'" param="$candidate"/>
                    <raise_lua_event name="'X4LAN_Bubble.PreparedProxy'" param="$peer"/>
                    <do_all exact="$extras.count" counter="$k">
                        <raise_lua_event name="'X4LAN_Bubble.PreparedExtra.%s'.[$k]" param="$extras.{$k}"/>
                    </do_all>
                    <do_if value="$args.$teleport">
                        <teleport_player object="$own" instant="true" force="true"/>
                    </do_if>
                    <raise_lua_event name="'X4LAN_Bubble.ShipsReady'"/>
                </do_else>
            </actions>
        </cue>
    </cues>
</mdscript>
